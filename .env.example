# ClosetBrain Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Express Server Port
PORT=5001

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/closetbrain?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/closetbrain?retryWrites=true&w=majority

# Strong secret for signing session cookies
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# Node Environment ('development' or 'production')
NODE_ENV=development

# Cloudflare R2 Private Bucket Configuration
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=closetbrain-wardrobe

# Google Gemini AI Vision Configuration
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
